# XaresAICoder Environment Configuration
# =====================================
# For detailed port configuration guide, see: docs/PORT_CONFIGURATION.md
# Quick Reference: Local=80/80, Internal=8000/8000, External SSL=80/7200

# ===================
# APPLICATION SETTINGS
# ===================

# Workspace management settings
MAX_WORKSPACES_PER_USER=5

# Resource limits per workspace
# - MAX_CONCURRENT_WORKSPACES: Maximum number of simultaneously running workspaces (default: 3)
# - CPU_PER_WORKSPACE: CPU cores allocated per workspace (default: 1.0, can be 0.5, 1, 2, 4, 8)
# - MEMORY_PER_WORKSPACE_MB: RAM limit in MB per workspace (default: 4096 = 4GB)
# - ENABLE_RESOURCE_LIMITS: Enable/disable resource limit enforcement (default: true)
MAX_CONCURRENT_WORKSPACES=3
CPU_PER_WORKSPACE=1.0
MEMORY_PER_WORKSPACE_MB=4096
ENABLE_RESOURCE_LIMITS=true

# Disk usage display in project list
# - true: Shows disk usage for each workspace (e.g., "17.2 GB", "943 MB")
# - false: Hides disk usage completely for better performance (default)
SHOW_DISK_USAGE=false

# Workspace sudo privileges
# - true: Allows sudo usage within workspace containers (less secure, more flexible)
# - false: Prevents privilege escalation including sudo (more secure, recommended for production)
WORKSPACE_SUDO_ENABLED=false
# (Default only: sudo can be chosen per workspace when creating or cloning.)

# Workspace seccomp profile
# - default: Docker's default profile (recommended). Blocks e.g. unprivileged user
#   namespaces, a common route for kernel exploits. Codex's own sandbox (bubblewrap)
#   cannot run then; new workspaces get sandbox_mode = "danger-full-access" in
#   ~/.codex/config.toml (the container is the sandbox). Chrome needs --no-sandbox
#   (Playwright's default).
# - unconfined: no syscall filtering (previous behavior)
WORKSPACE_SECCOMP=default

# Per-workspace disk limit for the container's writable layer, e.g. 20G.
# Only enforced when Docker uses overlay2 on xfs mounted with pquota; otherwise
# the server logs a warning and ignores it. Empty = no limit.
WORKSPACE_DISK_LIMIT=

# Container resource limits (ulimits)
# - CONTAINER_PIDS_LIMIT: Maximum number of processes (PIDs) per container
# - CONTAINER_MAX_FDS: File descriptor soft limit (default: 4096)
# - CONTAINER_MAX_FDS_HARD: File descriptor hard limit (default: 8192)
# - CONTAINER_MAX_PROCS: Process soft limit (default: 2048)
# - CONTAINER_MAX_PROCS_HARD: Process hard limit (default: 4096)
# Note: VS Code/code-server needs many processes for extensions and language servers
CONTAINER_PIDS_LIMIT=2048
CONTAINER_MAX_FDS=8192
CONTAINER_MAX_FDS_HARD=16384
CONTAINER_MAX_PROCS=2048
CONTAINER_MAX_PROCS_HARD=4096

# Docker logs per container (services and workspaces): a file is rotated at
# LOG_MAX_SIZE, LOG_MAX_FILE files are kept. Workspaces created before keep
# their previous setting until they are recreated.
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# Docker network name (managed automatically by Docker Compose)
DOCKER_NETWORK=xares-aicoder-network

# Name of the nginx container - used by the server to reload nginx
# when custom subdomain aliases are created or changed
NGINX_CONTAINER_NAME=xaresaicoder-nginx

# ===================
# PORT & DOMAIN CONFIGURATION
# ===================
# ⚠️  IMPORTANT: These settings determine how URLs are generated and how traffic is routed
# 📚 See docs/PORT_CONFIGURATION.md for detailed explanations and examples

# Domain name for workspace URLs (no http:// prefix)
BASE_DOMAIN=localhost

# Port for URL generation logic - determines if ":port" appears in workspace URLs
# - Set to 80: Creates clean URLs without port (e.g., http://workspace-id.localhost/)
# - Set to other: Includes port in URLs (e.g., http://workspace-id.localhost:8000/)
BASE_PORT=80

# Protocol for generated URLs (http or https)
# - For local/internal: use "http"
# - For external SSL proxy: use "http" (let external nginx handle HTTPS upgrade)
PROTOCOL=http

# Docker host port mapping - what port Docker exposes on the host machine
# - Local development: 80 (standard HTTP)
# - Internal server: 8000 (or any available port)  
# - External SSL proxy: 7200 (or any port that external nginx proxies to)
# - With a reverse proxy on the same host, bind to loopback (e.g.
#   127.0.0.1:7200): workspaces can then no longer reach nginx via the host
#   and bypass the reverse proxy's access control (see docs/SECURITY.md)
HOST_PORT=80

# ===================
# GIT SERVER (OPTIONAL)
# ===================

# Enable integrated Forgejo Git server
ENABLE_GIT_SERVER=false

# Git server admin configuration (only used if ENABLE_GIT_SERVER=true)
#
# Used only by the API server, never handed to a workspace: every workspace
# gets its own Forgejo user and an access token limited to it. The server
# creates those users, their tokens and private repositories, so the account
# must be a Forgejo administrator. GIT_ADMIN_PASSWORD is its password, or an
# access token of it with the scopes write:admin, write:user, write:repository
# (the server sends it via Basic Auth; then also set GIT_ADMIN_BOOTSTRAP_PASSWORD).
# ./deploy.sh replaces the default admin123! with a random password once;
# ./deploy.sh --rotate-git-password sets a new one at any time.
GIT_ADMIN_USER=developer
GIT_ADMIN_PASSWORD=admin123!

# Forgejo SECRET_KEY (signs sessions and CSRF tokens, encrypts 2FA/mirror/
# Actions secrets). Required; ./deploy.sh generates it if empty. Changing it
# later logs everybody out of Forgejo and makes encrypted secrets unreadable.
FORGEJO_SECRET_KEY=

# Password used to CREATE the Forgejo account (deploy.sh / setup-forgejo.sh).
# Falls back to GIT_ADMIN_PASSWORD when unset; deploy.sh keeps both in sync.
GIT_ADMIN_BOOTSTRAP_PASSWORD=admin123!

GIT_ADMIN_EMAIL=admin@xaresaicoder.local
GIT_SITE_NAME=XaresAICoder Git Server
GIT_SITE_DESCRIPTION=Integrated Git server for XaresAICoder development environment

# ===================
# ADMIN LOGIN
# ===================

# Password for the dashboard and its API (one shared admin login). The API is
# locked while this is empty; ./deploy.sh generates one if it is missing.
# Changing it ends all sessions. Sessions last ADMIN_SESSION_HOURS (default 12).
ADMIN_PASSWORD=
ADMIN_SESSION_HOURS=12

# ===================
# WORKSHOP MODE (OPTIONAL)
# ===================

# Workshop landing page for participant self-registration.
# - WORKSHOP_GROUP: project group workspaces are drawn from; empty disables workshop mode
# - WORKSHOP_ADMIN_PASSWORD: optional extra password for the workshop admin page
#   (claims / release); logged-in dashboard admins do not need it
WORKSHOP_GROUP=
WORKSHOP_ADMIN_PASSWORD=

# ===================
# NETWORK PROXY (OPTIONAL)
# ===================

# Enable Squid transparent proxy for network access control
# - true: Enables proxy with whitelist-based filtering and audit logging
# - false: Workspaces have direct internet access (default)
# See docs/OUTGOING_PROXY.md for configuration details
ENABLE_PROXY=false

# ===================
# GPU SUPPORT (OPTIONAL)
# ===================

# Enable GPU support for AI/ML workloads in workspaces
# - true: Enables NVIDIA GPU passthrough to workspace containers
# - false: Disables GPU support (default)
ENABLE_GPU=false

# ===================
# DOCKER IMAGES
# ===================

# Use pre-built images from registry instead of building locally
# - true: Faster deployment, uses GitHub Container Registry images
# - false: Builds images locally (slower but more control)
USE_REGISTRY_IMAGES=false

# Docker image names (automatically set based on USE_REGISTRY_IMAGES)
# Local build images:
SERVER_IMAGE=xares-aicoder-server:local
CODESERVER_IMAGE=xares-aicoder-codeserver:latest

# Registry images (used when USE_REGISTRY_IMAGES=true):
# SERVER_IMAGE=ghcr.io/yourusername/xaresaicoder-server:latest  
# CODESERVER_IMAGE=ghcr.io/yourusername/xaresaicoder-codeserver:latest

# ===================
# COMMON CONFIGURATIONS
# ===================
# Copy one of these configurations based on your deployment scenario:

# 🏠 LOCAL DEVELOPMENT
# BASE_DOMAIN=localhost
# BASE_PORT=80
# PROTOCOL=http  
# HOST_PORT=80

# 🏢 INTERNAL SERVER (Direct Access)
# BASE_DOMAIN=dev.company.internal
# BASE_PORT=8000
# PROTOCOL=http
# HOST_PORT=8000

# 🌐 INTERNET SERVER (External SSL Proxy)
# BASE_DOMAIN=coder.example.com
# BASE_PORT=80
# PROTOCOL=http
# HOST_PORT=7200
# Proxy Network Configuration (when ENABLE_PROXY=true)
# Each proxy has its own internal network, so Security Proxy workspaces cannot
# use the unrestricted mitmproxy. deploy.sh --enable-proxy checks both subnets
# for conflicts.
# LLM Logging Proxy workspaces (xares-internal)
INTERNAL_NETWORK_SUBNET=172.30.0.0/16
DNSMASQ_IP=172.30.0.2
PROXY_NETWORK=xaresaicoder_xares-internal
# Security Proxy workspaces (xares-security); squid only accepts this subnet
SECURITY_NETWORK_SUBNET=172.31.0.0/16
SECURITY_DNSMASQ_IP=172.31.255.254
SECURITY_PROXY_NETWORK=xaresaicoder_xares-security
